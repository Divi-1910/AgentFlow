# syntax=docker/dockerfile:1.7

FROM golang:1.25-bookworm AS build

WORKDIR /src

# Download dependencies before copying the source so ordinary source changes can
# reuse the module cache layer.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -trimpath -ldflags="-s -w" \
    -o /out/agentflow-runtime ./runtime

FROM debian:bookworm-slim AS runtime

# ca-certificates is required for HTTPS providers and MCP servers. The memory
# and scratchpad services validate that ripgrep is available during startup.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agentflow \
    && useradd --uid 10001 --gid 10001 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin agentflow \
    && install -d -o 10001 -g 10001 -m 0750 /var/lib/agentflow

COPY --from=build --chown=10001:10001 \
    /out/agentflow-runtime /usr/local/bin/agentflow-runtime

ENV RG_PATH=/usr/bin/rg

USER 10001:10001

EXPOSE 8080

# Kubernetes supplies the subcommand and flags, for example:
# serve --config /etc/agentflow/bundle.json --data /var/lib/agentflow --listen :8080
ENTRYPOINT ["/usr/local/bin/agentflow-runtime"]
