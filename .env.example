# Generate a local signing secret with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_local_secret

# AgentFlow owns provider credentials. Configure the providers you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Optional: enables the built-in web search tool.
TAVILY_API_KEY=

# Optional host-port overrides for the Compose stack.
AGENTFLOW_WEB_PORT=5174
AGENTFLOW_API_PORT=9090
